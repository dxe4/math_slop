{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maths-unhurried.example/schemas/catalog.schema.json",
  "title": "Maths, Unhurried catalog part or merged catalog",
  "description": "Structural contract for topics, articles, courses and labs. Cross-record uniqueness and references are checked by scripts/catalog.mjs.",
  "type": "object",
  "required": [
    "topics",
    "articles",
    "courses",
    "labs"
  ],
  "properties": {
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topic"
      }
    },
    "articles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/article"
      }
    },
    "courses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/course"
      }
    },
    "labs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lab"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "published"
      ]
    },
    "topic": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "entryPrerequisites"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "entryPrerequisites": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "article": {
      "type": "object",
      "required": [
        "id",
        "title",
        "topic",
        "level",
        "hook",
        "outcome",
        "prerequisites",
        "prerequisiteLabels",
        "formula",
        "visual",
        "proof",
        "sources",
        "metadataProvenance",
        "catalogFields",
        "tags",
        "updated",
        "license"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "topic": {
          "$ref": "#/$defs/id"
        },
        "level": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "L5"
          ]
        },
        "hook": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "outcome": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9:._/-]*$"
          }
        },
        "prerequisiteLabels": {
          "$ref": "#/$defs/stringArray"
        },
        "formula": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "visual": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "proof": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^\\s/@]+(?:[/?#][^\\s]*)?$"
          }
        },
        "status": {
          "enum": [
            "outline",
            "draft",
            "reviewed"
          ]
        },
        "metadataProvenance": {
          "type": "object",
          "required": [
            "lifecycleStatus"
          ],
          "properties": {
            "lifecycleStatus": {
              "$ref": "#/$defs/status"
            }
          }
        },
        "catalogLevelTo": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "L5"
          ]
        },
        "catalogFields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "updated": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "license": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "courseModule": {
      "type": "object",
      "required": [
        "title",
        "articleIds"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "articleIds": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "course": {
      "type": "object",
      "required": [
        "id",
        "title",
        "topic",
        "prerequisites",
        "outcomes",
        "modules",
        "capstone",
        "assessment",
        "status",
        "retained",
        "seriesId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "topic": {
          "$ref": "#/$defs/id"
        },
        "prerequisites": {
          "$ref": "#/$defs/stringArray"
        },
        "outcomes": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/courseModule"
          }
        },
        "capstone": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "assessment": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "retained": {
          "const": true
        },
        "seriesId": {
          "type": "string",
          "pattern": "^unhurried-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "metadataProvenance": {
          "type": "object",
          "description": "Historical path labels and hand estimates; not current learner-facing metadata."
        }
      }
    },
    "lab": {
      "type": "object",
      "required": [
        "id",
        "title",
        "topic",
        "articleIds",
        "controls",
        "readout",
        "invariant",
        "pitfalls",
        "accessibleFallback",
        "priority",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "topic": {
          "$ref": "#/$defs/id"
        },
        "articleIds": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "controls": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "readout": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "invariant": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "pitfalls": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "accessibleFallback": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "priority": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    }
  }
}
