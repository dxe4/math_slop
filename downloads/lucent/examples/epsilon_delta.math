# Claim: lim as x approaches 1 of x^2 is 1.
# Prove it with delta = min(1, epsilon/3), using |x+1| < 3.
# The sliders investigate a proposed choice; sampled success is not a proof.
scene "Choosing delta for a quadratic limit";
domain -0.5 2.5;
range -0.5 6;
param eps = 0.5 from 0.05 to 1.5;
param d = 0.15 from 0.01 to 1;
fn f(x) = x^2;
plot f color blue;
epsilon_delta f at 1 limit 1 epsilon eps delta d;
