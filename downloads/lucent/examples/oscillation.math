# This expression is undefined at x = 0; a limit uses a punctured neighborhood.
# Sequences 1/(pi/2+2*pi*n) and 1/(3*pi/2+2*pi*n) approach 0,
# while the corresponding function values stay at 1 and -1.
# A finite plot cannot resolve every oscillation close to zero.
scene "Oscillation near a missing point";
domain -1 1;
range -1.4 1.4;
param d = 0.2 from 0.01 to 0.8;
fn f(x) = sin(1/x);
plot f color violet;
epsilon_delta f at 0 limit 0 epsilon 0.5 delta d;
